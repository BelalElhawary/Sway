<div class="motion">
    <h2>Motion</h2>

    <div class="m-row">
        <div class="m-card ease">hover: ease</div>
        <div class="m-card linear">hover: linear</div>
        <div class="m-card steps">hover: steps(4)</div>
        <div class="m-card slow">hover: 1s delay .2s</div>
    </div>

    <div class="m-row">
        <button class="m-toggle" @onclick="() => wide = !wide">Toggle width</button>
        <div class="m-bar @(wide ? "wide" : null)"></div>
    </div>

    <div class="m-row">
        <div class="spinner"></div>
        <div class="pulse"></div>
        <div class="slide">slide in</div>
        <div class="bounce"></div>
        <div class="cycle"></div>
        <div class="paused"></div>
    </div>
</div>

@code { bool wide; }
