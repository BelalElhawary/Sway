<div class="stress">
    <div class="stress-head">
        <button @onclick="() => clicks++">Click me</button>
        <span>clicks: @clicks</span>
        <span class="stress-count">@Rows rows, scroll the list and hover the buttons</span>
    </div>
    <div class="stress-list">
        @for (int i = 0; i < Rows; i++)
        {
            <div class="s-row">
                <div class="s-avatar"></div>
                <div class="s-text">
                    <div class="s-title">Item @i</div>
                    <div class="s-sub">Description for item number @i with a little text</div>
                </div>
                <span class="s-tag">tag @(i % 7)</span>
                <button class="s-btn">Open</button>
            </div>
        }
    </div>
</div>

@code {
    const int Rows = 1500;
    int clicks;
}
