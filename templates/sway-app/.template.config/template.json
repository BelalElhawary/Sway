{
  "$schema": "http://json.schemastore.org/template",
  "author": "Sway",
  "classifications": [ "Desktop", "UI", "Sway" ],
  "identity": "Sway.Templates.App",
  "name": "Sway Desktop App",
  "shortName": "sway",
  "description": "A desktop app using Sway.Widgets with a Material 3 counter starter.",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "SwayApp",
  "preferNameDirectory": true,
  "symbols": {
    "swayRoot": {
      "type": "parameter",
      "datatype": "text",
      "description": "Path to the Sway repository checkout (the folder that contains Sway.Widgets).",
      "defaultValue": "../Sway",
      "replaces": "SWAY_ROOT"
    },
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [ { "choice": "net10.0" } ],
      "defaultValue": "net10.0",
      "replaces": "TARGET_FRAMEWORK"
    }
  },
  "primaryOutputs": [ { "path": "SwayApp.csproj" } ],
  "postActions": [
    { "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025", "description": "Restore NuGet packages", "manualInstructions": [ { "text": "Run 'dotnet restore'" } ], "continueOnError": true }
  ]
}
