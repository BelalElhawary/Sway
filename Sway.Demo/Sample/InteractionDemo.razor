<div class="inter">
    <div class="topbar">Fixed bar (position: fixed, z-index: 50) - scrolls with nothing</div>

    <h3>Scroll container</h3>
    <div class="scroller" tabindex="0" @onkeydown="OnKey">
        @for (int i = 1; i <= 14; i++)
        {
            <div class="item">Row @i</div>
        }
    </div>

    <h3>Positioning and stacking</h3>
    <div class="stage">
        <div class="anchor">
            relative anchor
            <span class="badge">3</span>
        </div>
        <div class="card clipcard">
            overflow: hidden card
            <div class="tip">absolute tip, clipped by its card</div>
        </div>
        <div class="menu-host">
            <button @onclick="() => menuOpen = !menuOpen">Menu</button>
            @if (menuOpen)
            {
                <div class="menu">
                    <div class="menu-item">Open</div>
                    <div class="menu-item">Save</div>
                </div>
            }
        </div>
        <div class="under">later content (painted after, but menu has z-index)</div>
    </div>

    <h3>Events</h3>
    <div class="events" @onclick="() => outer++">
        <button @onclick="() => inner++" @onclick:stopPropagation="true">Stops propagation (@inner)</button>
        <button @onclick="() => inner2++">Bubbles to parent (@inner2)</button>
        <span class="link" @onclick="() => spans++">inline span click (@spans)</span>
        <span>parent clicks: @outer</span>
    </div>
    <div class="enter" @onmouseenter="() => entered++" @onmouseleave="() => left++">enter/leave: @entered / @left</div>
    <p class="keys">Last key on scroller: @lastKey</p>
    <p class="tall-filler">Filler to make the page itself scrollable.</p>
    <p class="tall-filler">Filler.</p>
</div>

@code {
    bool menuOpen;
    int inner, inner2, outer, spans, entered, left;
    string lastKey = "-";

    void OnKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) => lastKey = e.Key;
}
