<div class="demo2">
    <div class="label">wrap (300px wide)</div>
    <div class="wrapbox">
        @foreach (var w in new[] { "alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta" })
        {
            <span class="tile">@w</span>
        }
    </div>

    <div class="label">justify-content: space-between / center / flex-end / space-evenly</div>
    <div class="jc between"><i>1</i><i>2</i><i>3</i></div>
    <div class="jc center"><i>1</i><i>2</i><i>3</i></div>
    <div class="jc end"><i>1</i><i>2</i><i>3</i></div>
    <div class="jc evenly"><i>1</i><i>2</i><i>3</i></div>

    <div class="label">row-reverse, margin-left:auto, align-items:flex-end</div>
    <div class="jc reverse"><i>1</i><i>2</i><i>3</i></div>
    <div class="jc auto"><i>1</i><i>2</i><i class="push">3 (auto margin)</i></div>
    <div class="jc bottom"><i>1</i><i class="tall">2</i><i>3</i></div>

    <div class="label">grid: auto-fill minmax(120px, 1fr)</div>
    <div class="autofill">
        @for (int n = 1; n <= 7; n++)
        {
            <div class="cell2">@n</div>
        }
    </div>

    <div class="label">grid: auto 1fr columns, align-items center, nested flex</div>
    <div class="form">
        <span>Name</span><div class="field">Ada Lovelace</div>
        <span>Role</span><div class="field row2"><b>Engineer</b><span class="spacer2"></span><em>since 1843</em></div>
    </div>
</div>
