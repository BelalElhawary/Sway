<div class="demo">
    <div class="bar">
        <span class="brand">Sway</span>
        <span class="spacer"></span>
        <button>One</button>
        <button class="secondary">Two</button>
    </div>

    <div class="row">
        <div class="box a">flex: 1</div>
        <div class="box b">flex: 2 (wider)</div>
        <div class="box c">fixed 90px</div>
    </div>

    <div class="chips">
        @foreach (var tag in new[] { "alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa" })
        {
            <span class="chip">@tag</span>
        }
    </div>

    <div class="grid">
        <div class="cell wide">span 2 columns</div>
        <div class="cell">3</div>
        <div class="cell tall">span 2 rows</div>
        <div class="cell">5</div>
        <div class="cell">6</div>
        <div class="cell">7</div>
    </div>

    <div class="column">
        <div class="box a">column, centered</div>
        <div class="box b grow">grows to fill</div>
        <div class="box c">end</div>
    </div>
</div>
