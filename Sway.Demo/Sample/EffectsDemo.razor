<div class="fx">
    <h2>Effects</h2>

    <div class="fx-row">
        <div class="fx-card shadow-soft">soft shadow</div>
        <div class="fx-card shadow-layered">layered + spread</div>
        <div class="fx-card shadow-inset">inset shadow</div>
        <div class="fx-card radii">per-corner radii</div>
    </div>

    <div class="fx-row">
        <div class="fx-card g-linear">linear 135deg</div>
        <div class="fx-card g-corner">to top right</div>
        <div class="fx-card g-radial">radial</div>
        <div class="fx-card g-stripes">repeating</div>
        <div class="fx-card g-hard">hard stops</div>
    </div>

    <div class="fx-row">
        <div class="fx-text shadowed">Text shadow</div>
        <div class="fx-text glow">Glow</div>
        <div class="fx-text clickme" @onclick="() => hits++">Rotated hit target: @hits</div>
        <div class="fx-text font-local">@@font-face local(): Demo Mono</div>
        <div class="fx-text font-url">@@font-face url(): Url Font</div>
        <div class="fx-text scaled">scale(1.2) skew</div>
    </div>

    <div class="fx-row filters">
        <div class="swatch plain"></div>
        <div class="swatch blur"></div>
        <div class="swatch gray"></div>
        <div class="swatch sepia"></div>
        <div class="swatch hue"></div>
        <div class="swatch invert"></div>
        <div class="swatch bright"></div>
        <div class="swatch contrast"></div>
        <div class="swatch dropshadow"></div>
    </div>
</div>

@code { int hits; }
