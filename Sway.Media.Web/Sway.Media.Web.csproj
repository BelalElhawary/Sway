<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Browser backend for Sway.Media: an HTML media element, with video frames copied into a bitmap. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sway.Media</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <ProjectReference Include="..\Sway.Media\Sway.Media.csproj" />
  </ItemGroup>

</Project>
